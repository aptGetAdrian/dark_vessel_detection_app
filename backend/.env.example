APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0
LOG_LEVEL=debug

# PostgreSQL — run with: docker run -d --name darkvessel-db \
#   -e POSTGRES_PASSWORD=secret -e POSTGRES_DB=darkvessel \
#   -p 5432:5432 postgres:16
DATABASE_URL=postgres://postgres:secret@localhost:5432/darkvessel

# AIS Hub — register free at https://www.aishub.net/register
AISHUB_USERNAME=your_username_here

# How often to poll AIS Hub (minimum 60s to respect rate limit)
AIS_POLL_INTERVAL_SEC=60

# Sentinel Hub (Copernicus Data Space Ecosystem) — optional, real SAR imagery
# Register free at https://dataspace.copernicus.eu
# After registering: Dashboard → User Settings → OAuth Clients → Create client
# If not set, the server uses simulated satellite detections (good enough for demo)
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
# How often to scan SAR imagery (hours). Default 12h — Sentinel-1 revisit is 1-3 days
SENTINEL_SCAN_INTERVAL_HOURS=12
